# Copiar a .env (sin .example) y completar.
# .env NUNCA se commitea — está en .gitignore.

GBM_EMAIL=tu-email@dominio.com
GBM_PASSWORD=tu-password

# Opcional — el CLIENT_ID público de la app web GBM (ya está como default en la lib)
# GBM_CLIENT_ID=7c464570619a417080b300076e163289

# Opcional — geolocalización fija (si no, se detecta por IP)
# GBM_LATITUDE=19.4326
# GBM_LONGITUDE=-99.1332
